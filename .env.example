# Copy to .env and fill in your own keys. NEVER commit .env.
# .env is gitignored.

# GWDG SAIA — required for v2 pipeline stage 1 (Docling + Qwen)
SAIA_API_KEY=

# Anthropic Claude — consensus judging (optional)
ANTHROPIC_API_KEY=

# Google AI Studio / Gemini — initial scoring (optional)
GEMINI_API_KEY=

# OpenRouter — alternative LLM routing (optional)
OPENROUTER_API_KEY=

# Azure Foundry — Opus-4.7 backend (optional)
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=

# Judge used by the monthly update: foundry (default), anthropic, openrouter or saia
JUDGE_PROVIDER=foundry
# Version for the Foundry Anthropic endpoint (optional)
AZURE_FOUNDRY_API_VERSION=

# ── Monthly update (pipeline/monthly_update.py) ──
# Contact email sent to NCBI E-utilities and Unpaywall (Unpaywall is skipped without it)
NCBI_EMAIL=
UNPAYWALL_EMAIL=
# Optional NCBI key: raises the PubMed rate limit from 3 to 10 requests/second
NCBI_API_KEY=
# Most papers to score per run (default 30)
MAX_PAPERS=
# rclone remote holding PDFs between runs, e.g. "store:" (leave empty to use work/ only)
STORE_REMOTE=
# Override where the private working files live (default: work/ in the repo)
WORK_DIR=
