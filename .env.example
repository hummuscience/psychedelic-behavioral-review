# Copy to .env and fill in your own keys. NEVER commit .env.
# .env is gitignored.

# GWDG SAIA — required for v2 pipeline stage 1 (Docling + Qwen)
SAIA_API_KEY=

# Anthropic Claude — consensus judging (optional)
ANTHROPIC_API_KEY=

# Google AI Studio / Gemini — initial scoring (optional)
GEMINI_API_KEY=

# OpenRouter — alternative LLM routing (optional)
OPENROUTER_API_KEY=

# Azure Foundry — Opus-4.7 backend (optional)
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
